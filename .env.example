# .env.example — copiar a .env.local (nunca commit)
# Dir de data (dev: el DuckDB/parquets de gestación; prod/VPS: copia sincronizada vía R2)
PRECIO_DATA_DIR=D:/Proyectos/precios/data
# buscador: 'sql' en dev (fallback LIKE), 'meili' en prod
PRECIO_SEARCH=sql
MEILI_URL=
MEILI_KEY=
# Supabase (F4)
SUPABASE_URL=
SUPABASE_ANON=
SUPABASE_SERVICE=
# R2 (F5, imgs de producto + sync)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET=
R2_BUCKET=precios-sepa
# revalidate ISR (lo golpea el cron de sync del VPS)
REVALIDATE_SECRET=
# emails de alertas (F4)
RESEND_KEY=
# From (opcional): con dominio verificado en Resend ej. alertas@remito.com.ar
RESEND_FROM=
# dominio público, para sitemap/emails — https://remito.com.ar
NEXT_PUBLIC_SITE_URL=http://localhost:3000
